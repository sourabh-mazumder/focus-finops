# Copy to .env and adjust as needed.
# Either set DATABASE_URL directly, or the discrete PG* vars below (used to
# build the connection URI if DATABASE_URL is unset).

# DATABASE_URL=postgresql://focus_app:focus_app_pw@localhost:5432/focus_finops

PGHOST=localhost
PGPORT=5432
PGDATABASE=focus_finops
PGUSER=focus_app
PGPASSWORD=focus_app_pw
